# Agent Nawa local config. Copy to `.env`; the app loads it on startup.
# Nothing here is secret — auth is your host ADC (gcloud auth application-default login).

# --- Connection store (optional) --------------------------------------------
# Local: connections persist to this JSON file (default config.json).
# CONFIG_PATH=config.json
# Cloud Run: store the list in a GCS bucket instead.
# CONFIG_BUCKET=my-project-agent-nawa-config
# CONFIG_OBJECT=connections.json

# --- Seed one Gemini connection on first run (optional, back-compat) ---------
# Only used when the store is empty; you can also add connections from the UI.
# PROJECT_ID=your-project-id
# AS_APP=your-app-id
# CID=your-client-id

# --- Usage telemetry / Antigravity tab (optional) ---------------------------
# Point these at the central BigQuery dataset fed by the inference_response log
# sink (terraform/setup/setup_antigravity_sink.sh). Unset = tab shows "not configured".
# CENTRAL_PROJECT=your-central-bq-project
# ANTIGRAVITY_BQ_DATASET=antigravity_monitoring
# ANTIGRAVITY_BQ_LOCATION=asia-northeast3
